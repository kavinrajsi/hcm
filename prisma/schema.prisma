// HRM Phase 1 core schema.
// Sensitive fields (PAN, Aadhaar, bank account, IFSC) are encrypted at the
// application layer (src/lib/crypto.ts) before write — columns hold
// `iv:tag:ciphertext`, never plaintext. `panHash`/`aadhaarHash` are HMAC
// blind indexes used for uniqueness/dedupe without decryption.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

enum EmpType {
  INTERN
  PROBATION
  PERMANENT
  CONTRACT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum IdCardStatus {
  PHOTO_TAKEN
  ASSIGNED_TO_DESIGNER
  PENDING
  ISSUED
  RE_ISSUE
  RETURN_PENDING // set automatically when the employee exits
  RETURNED
}

enum ProbationStatus {
  PENDING
  CONFIRMED
  EXTENDED
  EXITED // set when the employee exits unconfirmed; undo exit reopens it
}

enum SessionMode {
  IN_PERSON
  VIRTUAL
}

enum QuantumSource {
  MANUAL
  BASECAMP
}

enum Availability {
  AVAILABLE
  BUSY
  UNAVAILABLE
  UNKNOWN
}

enum LeaveType {
  FULL_DAY
  HALF_DAY
  LATE_ARRIVAL
  EARLY_LOGOUT
  WFH
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LetterType {
  OFFER
  INTERN
  COMPENSATION
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  name                   String?
  role                   Role                    @default(EMPLOYEE)
  passwordHash           String? // credentials fallback; null for SSO-only accounts
  googleId               String?                 @unique
  disabledAt             DateTime? // set = can't sign in (HR disabled, or employee exited)
  employee               Employee?
  resetTokens            PasswordResetToken[]
  leaveReviews           LeaveEntry[]            @relation("LeaveReviews")
  candidateStatusChanges CandidateStatusChange[]
  idCardStatusChanges    IdCardStatusChange[]
  chatThreads            ChatThread[]
  letterTemplateEdits    LetterTemplate[]
  commentLabels          CommentLabel[]
  designerBeliefs        DesignerBelief[]
  assignmentQueries      AssignmentQuery[]
  devicesAssigned        DeviceAssignment[]      @relation("DeviceAssignedBy")
  devicesReturned        DeviceAssignment[]      @relation("DeviceReturnedBy")
  deviceTickets          DeviceTicket[]          @relation("DeviceTicketReporter")
  deviceTicketEvents     DeviceTicketEvent[]     @relation("DeviceTicketEvents")
  devicePurchaseRequests DevicePurchaseRequest[] @relation("DevicePurchaseRequester")
  appSettingEdits        AppSetting[]            @relation("AppSettingEditor")
  oauthCodes             OAuthCode[]             @relation("OAuthCodes")
  oauthTokens            OAuthToken[]            @relation("OAuthTokens")
  mcpAuditLogs           McpAuditLog[]           @relation("McpAuditLogs")
  emailsSent             EmailLog[]              @relation("EmailsSent")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique // sha256 of the raw token; raw never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Employee {
  id     String  @id @default(cuid())
  empId  String  @unique
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique

  // Identity & personal
  name             String
  gender           Gender?
  dateOfBirth      DateTime? @db.Date
  bloodGroup       String?
  tshirtSize       String?
  phone            String?
  personalEmail    String?
  workEmail        String    @unique
  emergencyContact String?

  fatherName String?

  // Address
  address String?
  city    String?
  state   String?
  pincode String?

  // Employment
  department    String
  designation   String
  dateOfJoining DateTime  @db.Date
  empType       EmpType   @default(PROBATION)
  isFresher     Boolean   @default(true)
  dateOfExit    DateTime? @db.Date
  // Internship / contract end (INTERN, CONTRACT). Probation's date lives
  // on ProbationRecord.dueDate.
  empTypeEndsOn DateTime? @db.Date

  // Basecamp profile sync (the passport Photo above stays HR-managed).
  basecampPersonId String? @unique
  avatarBlobKey    String? // private blob, avatars/<empId>…
  avatarSourceUrl  String? // Basecamp avatar_url last downloaded

  // Statutory (plaintext-safe identifiers)
  pfNumber  String?
  uanNumber String?

  // Encrypted at application layer (iv:tag:ciphertext)
  panEnc         String?
  aadhaarEnc     String?
  bankAccountEnc String?
  ifscEnc        String?

  // Encrypted contact / personal / statutory fields (same iv:tag:ciphertext
  // format). The plaintext columns above are being retired: new writes go
  // here only; scripts/encrypt-pii.ts moves existing rows.
  phoneEnc            String?
  personalEmailEnc    String?
  emergencyContactEnc String?
  addressEnc          String?
  dateOfBirthEnc      String? // ISO date (YYYY-MM-DD)
  pfNumberEnc         String?
  uanNumberEnc        String?

  // Blind indexes (HMAC-SHA256) for uniqueness without decryption
  panHash         String? @unique
  aadhaarHash     String? @unique
  bankAccountHash String? @unique

  // Document uploads — Vercel Blob keys, not bytes
  photoBlobKey   String?
  panBlobKey     String?
  aadhaarBlobKey String?
  // Experienced hires (isFresher = false); letters per PreviousEmployment
  linkedinId     String?

  // Candidate this employee was converted from (candidates.id). No foreign
  // key: the candidates table belongs to the website.
  candidateId BigInt? @unique

  // Manager for team-scoped views (MANAGER role sees direct reports)
  manager   Employee?  @relation("Reports", fields: [managerId], references: [id])
  managerId String?
  reports   Employee[] @relation("Reports")

  onboarding          OnboardingRecord?
  idCard              IdCard?
  probation           ProbationRecord?
  quantumEntries      QuantumEntry[]
  registrations       SessionRegistration[]
  attendance          SessionAttendance[]
  letters             Letter[]
  reviewMeetings      ReviewMeeting[]
  freelancer          Freelancer?
  leaveEntries        LeaveEntry[]
  previousEmployments PreviousEmployment[]
  jobAssignments      JobAssignee[]
  devices             Device[]                @relation("DeviceHolder")
  deviceAssignments   DeviceAssignment[]
  purchaseRequests    DevicePurchaseRequest[]
  employmentReminders EmploymentReminder[]
  emailLogs           EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([dateOfJoining])
  @@index([department])
  @@index([dateOfExit])
}

model OnboardingRecord {
  id          String   @id @default(cuid())
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  String   @unique
  joinDate    DateTime @db.Date
  designation String
  empType     EmpType
  completedAt DateTime @default(now())

  @@index([joinDate])
}

model IdCard {
  id         String       @id @default(cuid())
  employee   Employee     @relation(fields: [employeeId], references: [id])
  employeeId String       @unique
  status     IdCardStatus @default(PHOTO_TAKEN)
  issuedAt   DateTime?
  updatedAt  DateTime     @updatedAt

  statusChanges IdCardStatusChange[]

  @@index([status])
}

/// One row per ID card status move (Photo Taken → Assigned to Designer …).
model IdCardStatusChange {
  id          String   @id @default(cuid())
  idCard      IdCard   @relation(fields: [idCardId], references: [id], onDelete: Cascade)
  idCardId    String
  fromStatus  String? // null = card created; text so retired statuses stay readable
  toStatus    String
  changedAt   DateTime @default(now())
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedById String?

  @@index([idCardId, changedAt(sort: Desc)])
}

model ProbationRecord {
  id          String          @id @default(cuid())
  employee    Employee        @relation(fields: [employeeId], references: [id])
  employeeId  String          @unique
  status      ProbationStatus @default(PENDING)
  dueDate     DateTime        @db.Date // when confirmation is due
  extendedTo  DateTime?       @db.Date
  confirmedAt DateTime?
  notes       String?
  updatedAt   DateTime        @updatedAt

  @@index([dueDate])
  @@index([status])
}

// Per-employee work log (Quantum Sheet). Manual entries or Basecamp import.
model QuantumEntry {
  id           String        @id @default(cuid())
  employee     Employee      @relation(fields: [employeeId], references: [id])
  employeeId   String
  date         DateTime      @db.Date
  brand        String
  workName     String
  link         String? // Basecamp/Figma URL
  durationMins Int
  source       QuantumSource @default(MANUAL)
  basecampId   String? // dedupe key for imported todos
  createdAt    DateTime      @default(now())

  @@unique([employeeId, basecampId])
  @@index([employeeId, date])
}

model TrainingSession {
  id            String                @id @default(cuid())
  name          String
  date          DateTime
  trainer       String
  mode          SessionMode           @default(IN_PERSON)
  notes         String?
  registrations SessionRegistration[]
  attendance    SessionAttendance[]
  createdAt     DateTime              @default(now())

  @@index([date])
}

model SessionRegistration {
  id         String          @id @default(cuid())
  session    TrainingSession @relation(fields: [sessionId], references: [id])
  sessionId  String
  employee   Employee        @relation(fields: [employeeId], references: [id])
  employeeId String
  createdAt  DateTime        @default(now())

  @@unique([sessionId, employeeId])
}

// Manual attendance log. sessionId optional — HR may log sessions that
// never went through the calendar; sessionName is the source of truth.
model SessionAttendance {
  id          String           @id @default(cuid())
  employee    Employee         @relation(fields: [employeeId], references: [id])
  employeeId  String
  session     TrainingSession? @relation(fields: [sessionId], references: [id])
  sessionId   String?
  sessionName String
  date        DateTime         @db.Date
  attended    Boolean          @default(true)
  trainer     String?
  notes       String?
  createdAt   DateTime         @default(now())

  @@index([employeeId, date])
  @@index([date])
}

// ~20k records — every filterable column indexed; server pagination only.
model Freelancer {
  id           String       @id @default(cuid())
  name         String
  email        String?
  phone        String?
  skillset     String
  rate         String? // free-form: "₹2500/day", "$40/hr"
  availability Availability @default(UNKNOWN)
  notes        String?
  // Linked only if converted to FTE
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  employeeId   String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([name])
  @@index([skillset])
  @@index([availability])
}

model Letter {
  id         String     @id @default(cuid())
  employee   Employee   @relation(fields: [employeeId], references: [id])
  employeeId String
  type       LetterType
  subject    String
  bodyHtml   String
  sentAt     DateTime?
  sentTo     String?
  createdAt  DateTime   @default(now())

  @@index([employeeId])
}

// Stub — fields to be finalized in a dedicated planning pass.
model ReviewMeeting {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  date       DateTime @db.Date
  notes      String?
  createdAt  DateTime @default(now())

  @@index([employeeId, date])
}

// Basecamp OAuth tokens, encrypted at the application layer.
model BasecampToken {
  id              String   @id @default(cuid())
  userId          String   @unique
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime
  accountId       String
  updatedAt       DateTime @updatedAt
}

// Leave posts imported from the Basecamp "Post your leave here" and
// "Post your WFH here" check-ins.
// Free-text answers are classified by AI; HR/managers can correct them
// (classifiedBy = "manual"), which the sync never overwrites.
model LeaveEntry {
  id           String      @id @default(cuid())
  basecampId   String      @unique // check-in answer id
  checkin      String      @default("leave") // source check-in: "leave" | "wfh"
  employee     Employee?   @relation(fields: [employeeId], references: [id])
  employeeId   String? // null when the poster's email matches no employee
  creatorName  String
  creatorEmail String
  postedOn     DateTime    @db.Date // Basecamp group_on
  postedAt     DateTime
  message      String // plain text, HTML stripped
  link         String
  type         LeaveType? // null = not yet classified
  startDate    DateTime?   @db.Date
  endDate      DateTime?   @db.Date
  days         Decimal?    @db.Decimal(4, 1)
  reason       String?
  classifiedBy String? // "ai" | "manual"
  status       LeaveStatus @default(PENDING)
  reviewedBy   User?       @relation("LeaveReviews", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([employeeId, startDate])
  @@index([postedOn])
  @@index([status])
}

// Job applications from the madarth.com career form (/api/career), which
// inserts with raw SQL — keep the snake_case table/column names stable.
// Migrated from Supabase `candidates`; ids preserved. Résumés live in Vercel
// Blob (private) at the `fileUrl` pathname. Non-empty `honeypot` = spam hit.
model Candidate {
  id           BigInt   @id @default(autoincrement())
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  firstName    String?  @map("first_name")
  lastName     String?  @map("last_name")
  email        String?
  mobileNumber String?  @map("mobile_number")
  position     String?
  jobRole      String?  @map("job_role")
  fileUrl      String?  @map("file_url")
  portfolio    String?
  status       String?  @default("New") // New | Screening | Interview | Offer | Freelancer | Rejected
  ipAddress    String?  @map("ip_address")
  location     String?
  sourceUrl    String?  @map("source_url")
  notes        String?
  orderIndex   Int?     @default(9999) @map("order_index")
  pageUrl      String?  @map("page_url")
  referrer     String?
  userAgent    String?  @map("user_agent")
  honeypot     String?  @default("")

  statusChanges CandidateStatusChange[]

  @@index([createdAt(sort: Desc)])
  @@map("candidates")
}

/// One row per status move (New → Screening …), written by HCM only.
model CandidateStatusChange {
  id          String    @id @default(cuid())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId BigInt    @map("candidate_id")
  fromStatus  String?   @map("from_status") // null = created in HCM
  toStatus    String    @map("to_status")
  changedAt   DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedBy   User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedById String?   @map("changed_by_id")

  @@index([candidateId, changedAt(sort: Desc)])
  @@map("candidate_status_changes")
}

// One row per AI Gateway call (tokens + cost as the Gateway reports them),
// for Admin → AI usage. Written best-effort; never blocks the caller.
model AiUsage {
  id           String   @id @default(cuid())
  feature      String // "leave-classify"
  trigger      String? // "webhook" | "cron" | "manual-sync" | "script"
  model        String
  items        Int // posts in the request
  inputTokens  Int
  outputTokens Int
  costUsd      Decimal? @db.Decimal(12, 8) // null when the Gateway sent no cost
  generationId String?
  ok           Boolean  @default(true) // false = request failed
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// MadMax chats: one thread per conversation, messages stored as AI SDK
// UIMessage parts so a thread reloads exactly as it streamed.
model ChatThread {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  title     String
  model     String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
}

model ChatMessage {
  id        String     @id // UIMessage id from the AI SDK
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  role      String // "user" | "assistant"
  parts     Json
  createdAt DateTime   @default(now())

  @@index([threadId, createdAt])
}

// HR-edited starting templates for Letters. No row = the default template in
// src/lib/letter-templates.ts; "Reset to default" deletes the row.
model LetterTemplate {
  type        LetterType @id
  subject     String
  body        String // email-safe HTML with {{placeholders}}
  updatedAt   DateTime   @updatedAt
  updatedBy   User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
}

// An experienced hire's earlier employer, with that company's letters
// (private Vercel Blob keys).
model PreviousEmployment {
  id                      String   @id @default(cuid())
  employee                Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId              String
  companyName             String
  position                Int      @default(0) // display order in the form
  offerLetterBlobKey      String?
  experienceLetterBlobKey String?
  relievingLetterBlobKey  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([employeeId, position])
}

// --- Assignment Intelligence (docs/assignment-intelligence) ---
// Completed Basecamp to-dos with their comment threads, so the floor manager
// can see how much rework a designer's similar past jobs needed. Comments
// are labelled by AI and by Client Coordinators; the coordinator labels are
// the ground truth the AI is measured against.

// One completed Basecamp to-do ("job"). Creator = the Client Coordinator
// who raised it; assignees = who did the work.
model Job {
  id                String        @id @default(cuid())
  basecampTodoId    String        @unique
  bucketId          String // Basecamp project id
  bucketName        String // project (client) name
  todolistTitle     String
  title             String
  description       String // plain text, HTML stripped
  link              String // app_url
  creatorPersonId   String
  creatorName       String
  creatorEmail      String?
  createdAtBasecamp DateTime
  completedAt       DateTime
  completedBy       String? // completion.creator (name only)
  commentsCount     Int           @default(0)
  basecampUpdatedAt DateTime
  // AI-assigned kind of design (src/lib/assign/taxonomy.ts); null = pending.
  kind              String?
  kindBy            String? // "ai" | "manual"
  // Labelling sample membership: "train" | "dev" | "holdout" | null.
  evalSet           String?
  assignees         JobAssignee[]
  comments          JobComment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([kind])
  @@index([creatorPersonId])
  @@index([completedAt])
  @@index([evalSet])
}

model JobAssignee {
  id         String    @id @default(cuid())
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String
  personId   String // Basecamp person id
  name       String
  email      String?
  title      String? // Basecamp job title, used to tell designers apart
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeId String?

  @@unique([jobId, personId])
  @@index([personId])
}

// One comment on a job. `aiLabels` come from the classifier; coordinator
// labels live in CommentLabel (one row per labeller).
model JobComment {
  id             String         @id @default(cuid())
  basecampId     String         @unique
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId          String
  authorPersonId String
  authorName     String
  authorEmail    String?
  postedAt       DateTime
  content        String // plain text, HTML stripped
  link           String
  aiLabels       String[]       @default([])
  aiLabelledAt   DateTime?
  labels         CommentLabel[]
  createdAt      DateTime       @default(now())

  @@index([jobId, postedAt])
  @@index([aiLabelledAt])
}

// A Client Coordinator's reading of one comment (src/lib/assign/taxonomy.ts
// categories). Kept per labeller so two coordinators can be compared.
model CommentLabel {
  id        String     @id @default(cuid())
  comment   JobComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  labels    String[]   @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([commentId, userId])
  @@index([userId])
}

// What the floor manager believes about a designer for a kind of job,
// written down before seeing any suggestion. Create-only: never edited.
model DesignerBelief {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  personId  String // Basecamp person id of the designer
  kind      String
  level     String // "strong" | "ok" | "weak" | "unknown"
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, personId, kind])
}

// One "Who should take this?" question and what the system answered, plus
// who the floor manager actually picked — for comparing the two later.
model AssignmentQuery {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  description     String
  coordinatorId   String? // Basecamp person id
  kind            String
  kindBy          String // "ai" | "manual"
  result          Json // SuggestionResult snapshot
  chosenPersonId  String?
  chosenAt        DateTime?
  // The "[test] …" to-do created in Basecamp for the pick, if any.
  basecampTodoId  String?
  basecampTodoUrl String?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

// --- Devices (laptops, mice, iPads, USB hubs) ---
// Company devices with a QR label. The QR encodes /d/<publicToken>, a
// random token so asset tags can't be enumerated from outside.

enum DeviceType {
  LAPTOP
  MOUSE
  IPAD
  MOBILE
  USB_HUB
  OTHER
}

enum DeviceOs {
  MAC
  WINDOWS
  OTHER
}

enum DeviceOwnership {
  OWNED
  RENTED
}

enum DeviceStatus {
  IN_STOCK
  ASSIGNED
  IN_SERVICE
  RETIRED
  LOST
}

enum VendorKind {
  SALES // sells devices
  SERVICE // repairs devices
  BOTH
}

enum DeviceTicketStatus {
  OPEN
  SENT_FOR_SERVICE
  RESOLVED
  CANCELLED
}

model Device {
  id             String          @id @default(cuid())
  assetTag       String          @unique // MAD-LAP-0007, or MAD-LAP-<emp code> while assigned
  stockTag       String?         @unique // the numbered tag it returns to (MAD-LAP-0007)
  publicToken    String          @unique
  type           DeviceType
  brand          String
  model          String
  serialNumber   String?         @unique
  specs          String?
  os             DeviceOs? // laptops: Mac or Windows
  purchaseDate   DateTime?       @db.Date
  purchasePrice  Decimal?        @db.Decimal(12, 2)
  vendor         Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorId       String?
  warrantyEndsOn DateTime?       @db.Date
  notes          String?
  ownership      DeviceOwnership @default(OWNED)
  monthlyRent    Decimal?        @db.Decimal(12, 2) // rented devices
  vendorRef      String? // the vendor's own label, e.g. "Laptop2"
  status         DeviceStatus    @default(IN_STOCK)
  // Current holder, kept in step with the open DeviceAssignment.
  holder         Employee?       @relation("DeviceHolder", fields: [holderId], references: [id], onDelete: SetNull)
  holderId       String?

  assignments     DeviceAssignment[]
  tickets         DeviceTicket[]
  purchaseRequest DevicePurchaseRequest?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([type])
  @@index([status])
  @@index([holderId])
  @@index([vendorId])
}

/// Who held a device and when. Open row = returnedAt null.
model DeviceAssignment {
  id           String    @id @default(cuid())
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId     String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId   String
  assignedAt   DateTime  @default(now())
  returnedAt   DateTime?
  conditionOut String?
  conditionIn  String?
  assignedBy   User?     @relation("DeviceAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedById String?
  returnedBy   User?     @relation("DeviceReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  returnedById String?

  @@index([deviceId, assignedAt(sort: Desc)])
  @@index([employeeId])
}

/// An issue reported on a device, and its trip to service if it went.
model DeviceTicket {
  id              String              @id @default(cuid())
  device          Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  deviceId        String
  title           String
  description     String
  status          DeviceTicketStatus  @default(OPEN)
  reportedBy      User?               @relation("DeviceTicketReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  reportedById    String?
  serviceVendor   Vendor?             @relation("ServiceVendor", fields: [serviceVendorId], references: [id], onDelete: SetNull)
  serviceVendorId String?
  sentAt          DateTime?
  expectedBackOn  DateTime?           @db.Date
  returnedAt      DateTime?
  cost            Decimal?            @db.Decimal(12, 2)
  resolution      String?
  events          DeviceTicketEvent[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([deviceId, createdAt(sort: Desc)])
  @@index([status])
}

/// One row per ticket status move (Open → Sent for service …).
model DeviceTicketEvent {
  id          String       @id @default(cuid())
  ticket      DeviceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId    String
  fromStatus  String? // null = ticket created
  toStatus    String
  note        String?
  changedBy   User?        @relation("DeviceTicketEvents", fields: [changedById], references: [id], onDelete: SetNull)
  changedById String?
  changedAt   DateTime     @default(now())

  @@index([ticketId, changedAt])
}

/// Who sells and repairs company devices, with how to reach them.
model Vendor {
  id               String                  @id @default(cuid())
  name             String                  @unique
  kind             VendorKind              @default(BOTH)
  contactPerson    String? // retired: moved to VendorContact; kept until dropped safely
  email            String? // company email
  phone            String // company phone
  altPhone         String?
  contacts         VendorContact[]
  address          String?
  notes            String?
  active           Boolean                 @default(true) // inactive = hidden from pickers
  devices          Device[]
  serviceTickets   DeviceTicket[]          @relation("ServiceVendor")
  purchaseRequests DevicePurchaseRequest[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([kind, active])
}

enum PurchaseRequestStatus {
  PENDING // saved; email not sent yet (or the send failed — see sendError)
  SENT
  RECEIVED
  CANCELLED
}

/// A device asked for from a vendor by email, usually for a new joiner.
model DevicePurchaseRequest {
  id            String                @id @default(cuid())
  employee      Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeId    String?
  vendor        Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorId      String
  type          DeviceType
  os            DeviceOs?
  itemName      String // what to buy, e.g. "Dell Latitude 5440, 16 GB / 512 GB"
  quantity      Int                   @default(1)
  neededBy      DateTime?             @db.Date
  notes         String?
  status        PurchaseRequestStatus @default(PENDING)
  // What was (or will be) emailed — kept so a resend and the record agree.
  emailTo       String
  emailCc       String[]              @default([])
  emailReplyTo  String
  emailSubject  String
  contactName   String? // who the email greets
  sentAt        DateTime?
  emailId       String? // ZeptoMail request id
  sendError     String?
  requestedBy   User?                 @relation("DevicePurchaseRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedById String?
  device        Device?               @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceId      String?               @unique // the device that arrived
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([employeeId])
}

/// Small HR-editable settings (JSON per key), e.g. purchase request emails.
model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("AppSettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
}

/// A person at a vendor (sales, service, accounts…). One may be primary.
model VendorContact {
  id        String   @id @default(cuid())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId  String
  name      String
  role      String?
  email     String?
  phone     String?
  altPhone  String?
  isPrimary Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, position])
}

// --- MCP access (AI apps such as Claude and ChatGPT, via OAuth) ---
// HCM is its own OAuth 2.1 authorization server for the MCP endpoint at
// /api/mcp. Tokens and codes are stored only as SHA-256 hashes.

/// An AI app that can ask users for access. Either registered by the app
/// itself (DCR, id is a random string) or identified by its metadata URL
/// (CIMD, id is that https URL).
model OAuthClient {
  id               String       @id // client_id
  name             String
  redirectUris     String[]
  clientUri        String?
  logoUri          String?
  kind             String       @default("dcr") // "dcr" | "cimd"
  clientSecretHash String? // confidential DCR clients only
  codes            OAuthCode[]
  tokens           OAuthToken[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

/// Authorization code, single use, 10 minutes, PKCE (S256) bound.
model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  user          User        @relation("OAuthCodes", fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  redirectUri   String
  codeChallenge String
  scope         String
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())
}

/// One connection (grant): an access token and its rotating refresh token.
model OAuthToken {
  id               String      @id @default(cuid())
  accessHash       String      @unique
  refreshHash      String      @unique
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId         String
  user             User        @relation("OAuthTokens", fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  scope            String
  resource         String?
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime    @default(now())

  @@index([userId, revokedAt])
}

/// Every change made through MCP: who, from which AI app, what, outcome.
model McpAuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation("McpAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  clientName String
  tool       String
  input      Json
  ok         Boolean
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

/// A one-week "employment ends soon" reminder already sent to HR, so each
/// end date (probation confirmation, contract end, internship end) is
/// reminded once. An extended probation has a new date and a new reminder.
model EmploymentReminder {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  kind       String // "probation" | "contract" | "internship"
  endsOn     DateTime @db.Date
  sentAt     DateTime @default(now())

  @@unique([employeeId, kind, endsOn])
}

enum EmailStatus {
  SENT
  FAILED
  NOT_SENT // email not configured (ZEPTOMAIL_TOKEN unset)
}

enum EmailDelivery {
  DELIVERED
  OPENED
  BOUNCED
}

/// Every email HCM sends (Admin → Email log). `html` has password and
/// invite links removed. Delivery comes from ZeptoMail webhooks. Rows
/// older than a year are deleted daily.
model EmailLog {
  id              String         @id @default(cuid())
  kind            String // template key, e.g. "type-change" (see email-catalog)
  from            String
  to              String[]
  cc              String[]
  replyTo         String?
  subject         String
  html            String
  attachmentNames String[]
  status          EmailStatus
  error           String?
  providerId      String? // ZeptoMail request_id
  delivery        EmailDelivery?
  deliveryAt      DateTime?
  events          Json           @default("[]")
  resendable      Boolean        @default(true)
  employee        Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeId      String?
  sentBy          User?          @relation("EmailsSent", fields: [sentById], references: [id], onDelete: SetNull)
  sentById        String?
  resendOfId      String?
  createdAt       DateTime       @default(now())

  @@index([createdAt])
  @@index([kind])
  @@index([status])
  @@index([providerId])
}
